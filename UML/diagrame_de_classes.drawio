        <mxCell id="lOmNNhYGq2kQKzYbXxt6-3" parent="1" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=66;verticalAlign=top;align=left;rounded=1;roundedPerimeter=1;fillColor=#fff2cc;strokeColor=#d6b656;gradientColor=#ffd966;" value="&lt;span data-lucid-type=&quot;application/vnd.lucid.text&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Explication des fonctions : &lt;br&gt;&lt;br&gt;GOBLINS&lt;/b&gt;&lt;br&gt;&lt;ul&gt;&lt;li&gt;&lt;span data-lucid-type=&quot;application/vnd.lucid.text&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;lancer flèches --&amp;gt; via un lancer de flèches diminue la population visée&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span data-lucid-type=&quot;application/vnd.lucid.text&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;seRepetreDunBonBBQ --&amp;gt; utilise bois et nourriture mais donne de l&#39;énergie ? ou alors fait gagner de  la population ? &lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span data-lucid-type=&quot;application/vnd.lucid.text&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;mangerMouche --&amp;gt; empoisonne les goblins = perte de population&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span data-lucid-type=&quot;application/vnd.lucid.text&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;se Moquer Nains --&amp;gt; les goblins jettent des pierres = perte de ressources pierres &lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;br&gt;&lt;b&gt;CANARDS&lt;/b&gt;&lt;br&gt;&lt;ul style=&quot;&quot;&gt;&lt;li style=&quot;&quot;&gt;&lt;span data-lucid-type=&quot;application/vnd.lucid.text&quot; style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;attaque de TPT --&amp;gt; crée plein de canards partout = augmentation population &lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;span data-lucid-type=&quot;application/vnd.lucid.text&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;faireCoincoin --&amp;gt; fais très peur à la population énemie et l&#39;empeche d&#39;attaquer pendant un certain temps&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;span data-lucid-type=&quot;application/vnd.lucid.text&quot; style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;danseDesCanards --&amp;gt; augmente l&#39;attaque momentanément : les canards se sont mis colllectivement en transe et sont maintenant ultra-puissant.&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;TEUTEU&lt;/b&gt;&lt;br&gt;&lt;ul&gt;&lt;li&gt;&lt;span data-lucid-type=&quot;application/vnd.lucid.text&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;mangerCrotteDeNez --&amp;gt;  ils ne mange donc pas de #Nourriture  -&amp;gt; le stock de nourriture ne diminue pas&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span data-lucid-type=&quot;application/vnd.lucid.text&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt; sentirSonDoigt--&amp;gt; les rends très heureux l&#39;espace d&#39;un instant, il ne se passe rien mais la population augmente car l&#39;indice de bonheur du royaume est au plus haut (permettant une meilleure reproduction).&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;br&gt;&lt;b&gt;LICORNES&lt;/b&gt;&lt;br&gt;&lt;ul&gt;&lt;li&gt;&lt;span data-lucid-type=&quot;application/vnd.lucid.text&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;corneDansLAnu --&amp;gt;   ?&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span data-lucid-type=&quot;application/vnd.lucid.text&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt; peterArcEnCiel --&amp;gt; Tout le monde se sent plus léger, permet de meilleur stat de combat lors d&#39;une alliance&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span data-lucid-type=&quot;application/vnd.lucid.text&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;mangerCarotteMagique --&amp;gt;  Fais apparaitre de l&#39;or, échangeable contre d&#39;autres ressources&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;br&gt;&lt;b&gt;PRINCESSES  &lt;/b&gt;&lt;br&gt;&lt;ul style=&quot;&quot;&gt;&lt;li style=&quot;&quot;&gt;&lt;span data-lucid-type=&quot;application/vnd.lucid.text&quot; style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;roterFeu --&amp;gt;  Detruit un batiment chez le royaume ennemi &lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;span data-lucid-type=&quot;application/vnd.lucid.text&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;faireLooping --&amp;gt; évite l&#39;attaque énemie&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;span data-lucid-type=&quot;application/vnd.lucid.text&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;ultraBadasse --&amp;gt; &lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;span data-lucid-type=&quot;application/vnd.lucid.text&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;princessOnFire --&amp;gt; l&#39;attaque est décuplé pour un moment&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;span data-lucid-type=&quot;application/vnd.lucid.text&quot; style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;organiserUnHellFest --&amp;gt; Renforce les alliances, &lt;span style=&quot;text-decoration: line-through;&quot;&gt;de l&#39;or&lt;/span&gt; de l&#39;argent magique est distribué aléatoirement à leur alliés.&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;Y&#39;a pas le poule rennard vipere&amp;nbsp;&lt;/font&gt;&lt;/span&gt;" vertex="1">
